{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot dev-server.ts",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@file-drive/api": "workspace:*",
		"@file-drive/auth": "workspace:*",
		"@file-drive/db": "workspace:*",
		"@file-drive/env": "workspace:*",
		"@hono/trpc-server": "^0.4.2",
		"@trpc/server": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@file-drive/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3"
	}
}
