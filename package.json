{
	"name": "file-drive",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"@types/bun": "^1.3.14",
			"@types/node": "^26.2.0",
			"hono": "^4.12.32",
			"@trpc/server": "^11.18.0",
			"better-auth": "1.7.1",
			"@better-auth/expo": "1.7.1",
			"drizzle-kit": "^0.31.10",
			"drizzle-orm": "^0.45.2",
			"lucide-react": "^1.27.0",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.7",
			"@trpc/tanstack-react-query": "^11.18.0",
			"@trpc/client": "^11.18.0",
			"@tanstack/react-query": "^5.101.4",
			"@tanstack/react-form": "^1.33.2",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3",
			"tailwind-merge": "^3.6.0"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev --ui=tru",
		"build": "turbo run build --ui=tui",
		"check-types": "turbo run check-types --ui=tui",
		"dev:native": "turbo run dev -F native --ui=tui",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"db:push": "turbo run db:push -F @file-drive/db --",
		"db:studio": "turbo run db:studio -F @file-drive/db --",
		"db:generate": "turbo run db:generate -F @file-drive/db --",
		"db:migrate": "turbo run db:migrate -F @file-drive/db",
		"db:start": "turbo run db:start -F @file-drive/db --",
		"db:watch": "turbo run db:watch -F @file-drive/db --",
		"db:stop": "turbo run db:stop -F @file-drive/db --",
		"db:down": "turbo run db:down -F @file-drive/db --",
		"db:remove": "turbo run db:remove -F @file-drive/db --",
		"db:migrate-prod": "bun run ./scripts/migrate-prod.ts",
		"s3:start": "turbo run s3:start -F @file-drive/s3 --",
		"s3:watch": "turbo run s3:watch -F @file-drive/s3 --",
		"s3:stop": "turbo run s3:stop -F @file-drive/s3 --",
		"s3:down": "turbo run s3:down -F @file-drive/s3 --",
		"s3:remove": "turbo run s3:remvoe -F @file-drive/s3 --",
		"deploy:setup": "vercel link",
		"dev:vercel": "vercel dev -L",
		"env:preview": "tsx scripts/sync-vercel-env.ts preview",
		"env:production": "tsx scripts/sync-vercel-env.ts production",
		"deploy": "vercel deploy",
		"deploy:prod": "vercel deploy --prod",
		"deploy:check": "vercel deploy --dry",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@better-auth/expo": "^1.7.1",
		"@file-drive/env": "workspace:*",
		"better-auth": "^1.7.1",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@file-drive/config": "workspace:*",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"tsx": "^4.23.12",
		"turbo": "^2.10.11",
		"typescript": "^6.0.3",
		"vercel": "^59.5.0"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "bun@1.3.14"
}
